# Скопируйте в .env.local для локальной разработки и добавьте те же
# переменные в Vercel → Settings → Environment Variables для прода.
# Файл .env.local в git не попадает.

# --- Админка ---
# Логин и пароль, которые вы выдаёте клиенту.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# Случайная строка от 32 символов: подписывает сессионную куку.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Публикация в GitHub ---
# Fine-grained токен с правом Contents: Read and write только на этот репозиторий.
# Без токена админка работает локально и пишет файлы прямо на диск.
GITHUB_TOKEN=
GITHUB_REPO=Puhich/neon-graphics
GITHUB_BRANCH=main

# --- Заявки в Telegram ---
# Токен бота от @BotFather и id чата, куда падают заявки.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Заявки на почту (Яндекс) ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
# Пароль приложения из Яндекс ID, а не основной пароль от почты.
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
